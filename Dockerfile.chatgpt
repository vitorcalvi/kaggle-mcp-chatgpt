FROM node:22-bookworm-slim

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /usr/local/bin/

RUN npm install --global mcp-proxy@6.7.19 \
    && uv tool install kaggle-mcp-server==0.2.0 --with 'mcp<2'

ENV PATH="/root/.local/bin:${PATH}" \
    PORT=8080 \
    PYTHONUNBUFFERED=1

EXPOSE 8080

CMD ["sh", "-c", "exec mcp-proxy --host 0.0.0.0 --port ${PORT:-8080} --server stream --streamEndpoint /mcp --no-eventStore -- kaggle-mcp-server"]
